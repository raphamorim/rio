+//! boo editor panes: the boo editor core embedded as a native Rio pane
+//! (phase 5 of boo's docs/design/003-libboo.md).
+//!
+//! No PTY, no child process, no escape round-trip on input: Rio's
+//! already-decoded key events convert straight into boo's structured
+//! key events and drive `boo_core::surface::Surface` in-process. On the
+//! way out, the surface renders into its own scene grid and the
+//! composed frame (escape text plus the out-of-grid raw queues — kitty
+//! images, Glyph Protocol) feeds the pane's `Crosswords` through the
+//! VT parser, exactly like an rmx virtual buffer: damage tracking,
+//! styles, cursor shape, and graphics all reuse the terminal render
+//! pipeline unchanged.
+
+use std::path::PathBuf;
+use std::time::Instant;
+
+use rio_backend::crosswords::Crosswords;
+use rio_backend::event::EventListener;
+use rio_backend::performer::handler::Processor;
+use rio_window::event::{ElementState, KeyEvent as HostKeyEvent};
+use rio_window::keyboard::{Key as HostKey, ModifiersState, NamedKey};
+
+use boo_core::surface::{Effect, Surface};
+
+/// One embedded editor. Lives on `Context.boo`; the context's
+/// `Crosswords` is the pane's display, this struct is its brain.
+pub struct BooPane {
+    pub surface: Surface,
+    scene: screen::Screen,
+    parser: Processor,
+    /// Set when editor state changed and the pane must re-present.
+    pub needs_paint: bool,
+}
+
+/// What a key delivered to the pane asked of the host.
+#[derive(PartialEq)]
+pub enum BooInput {
+    Handled,
+    /// The editor requested quit: close this pane.
+    Quit,
+}
+
+impl BooPane {
+    /// A pane rooted at `cwd`, opening on the fuzzy finder over the
+    /// workspace files — the same flow as `boo <dir>`.
+    pub fn new(cwd: PathBuf, cols: u16, rows: u16) -> Self {
+        let mut editor = boo_core::editor::Editor::new(cwd.clone());
+        let files = boo_core::finder::collect_files(&cwd);
+        editor
+            .layers
+            .push(boo_core::layer::Layer::Finder(boo_core::finder::Finder::new(
+                files,
+            )));
+
+        let mut scene = screen::Screen::new(rows.max(2), cols.max(2));
+        let _ = scene.set_cursor_style(5); // blinking bar
+        let _ = scene.cursor_visible(true);
+        let _ = scene.set_base(boo_core::ui::theme::FG, boo_core::ui::theme::BG);
+
+        BooPane {
+            surface: Surface::new(editor),
+            scene,
+            parser: Processor::default(),
+            needs_paint: true,
+        }
+    }
+
+    /// Push one host key event. Returns `None` when the event doesn't
+    /// map to an editor key (lone modifiers, media keys).
+    pub fn key(&mut self, key: &HostKeyEvent, mods: ModifiersState) -> Option<BooInput> {
+        let boo_key = convert_key(key, mods)?;
+        self.needs_paint = true;
+        if self.surface.key(boo_key).is_break() {
+            return Some(BooInput::Quit);
+        }
+        Some(BooInput::Handled)
+    }
+
+    /// Apply pasted text as one edit.
+    pub fn paste(&mut self, text: String) {
+        self.surface.paste(text);
+        self.needs_paint = true;
+    }
+
+    /// Editor-requested host side effects since the last drain.
+    pub fn drain_effects(&mut self) -> Vec<Effect> {
+        self.surface.drain_effects()
+    }
+
+    /// True while the kinetic glide needs ~60fps frames.
+    pub fn is_gliding(&self) -> bool {
+        self.surface.editor.kinetic.is_gliding()
+    }
+
+    pub fn tick(&mut self, now: Instant) {
+        self.surface.tick(now);
+        self.needs_paint = true;
+    }
+
+    /// Adopt the pane's current cell geometry. A no-op while unchanged.
+    pub fn resize(&mut self, cols: u16, rows: u16) {
+        let (cur_rows, cur_cols) = self.scene.get_size().unwrap_or((0, 0));
+        if (cur_rows, cur_cols) != (rows, cols) && rows > 1 && cols > 1 {
+            self.scene.set_size(rows, cols);
+            self.needs_paint = true;
+        }
+    }
+
+    /// Present one frame into the pane's terminal: pre-grid raw bytes,
+    /// the composed grid diff, post-grid raw bytes — the same order
+    /// boo's own tty presenter writes them.
+    pub fn present_into<T: EventListener>(&mut self, terminal: &mut Crosswords<T>) {
+        self.needs_paint = false;
+        self.surface.prepare();
+        if self.surface.render(&mut self.scene).is_err() {
+            return;
+        }
+        let mut bytes = self.scene.drain_raw();
+        if let Ok(frame) = self.scene.compose() {
+            bytes.extend_from_slice(frame.as_bytes());
+        }
+        bytes.extend(self.scene.drain_raw_after());
+        self.parser.advance(terminal, &bytes);
+    }
+}
+
+/// Decode a host key event into boo's kitty-shaped key. Shift is baked
+/// into `Key::Character` codepoints by the platform; functional keys
+/// carry the kitty PUA codes boo's collapse expects.
+fn convert_key(key: &HostKeyEvent, mods: ModifiersState) -> Option<screen::Key> {
+    let code = match key.logical_key.as_ref() {
+        HostKey::Named(named) => named_code(&named)?,
+        HostKey::Character(s) => s.chars().next()? as u32,
+        _ => return None,
+    };
+
+    let mut modifiers = screen::Modifiers::empty();
+    if mods.shift_key() {
+        modifiers |= screen::Modifiers::SHIFT;
+    }
+    if mods.alt_key() {
+        modifiers |= screen::Modifiers::ALT;
+    }
+    if mods.control_key() {
+        modifiers |= screen::Modifiers::CTRL;
+    }
+    if mods.super_key() {
+        modifiers |= screen::Modifiers::SUPER;
+    }
+
+    let event_type = match (key.state, key.repeat) {
+        (ElementState::Pressed, false) => screen::KeyEventType::Press,
+        (ElementState::Pressed, true) => screen::KeyEventType::Repeat,
+        (ElementState::Released, _) => screen::KeyEventType::Release,
+    };
+
+    Some(screen::Key::from_event(screen::KeyEvent {
+        code,
+        modifiers,
+        event_type,
+        shifted_key: None,
+        base_key: None,
+        text: None,
+    }))
+}
+
+/// kitty keyboard protocol PUA assignments (what `boo_key` in the C
+/// ABI takes too).
+fn named_code(named: &NamedKey) -> Option<u32> {
+    Some(match named {
+        NamedKey::Space => ' ' as u32,
+        NamedKey::Escape => 57344,
+        NamedKey::Enter => 57345,
+        NamedKey::Tab => 57346,
+        NamedKey::Backspace => 57347,
+        NamedKey::Insert => 57348,
+        NamedKey::Delete => 57349,
+        NamedKey::ArrowLeft => 57350,
+        NamedKey::ArrowRight => 57351,
+        NamedKey::ArrowUp => 57352,
+        NamedKey::ArrowDown => 57353,
+        NamedKey::PageUp => 57354,
+        NamedKey::PageDown => 57355,
+        NamedKey::Home => 57356,
+        NamedKey::End => 57357,
+        _ => return None,
+    })
+}
